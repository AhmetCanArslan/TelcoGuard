DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=case1_db
DB_SSLMODE=disable

SERVER_PORT=3000
SERVER_HOST=0.0.0.0

ENV=development

JWT_SECRET=your-jwt-secret-key-change-me
JWT_REFRESH_SECRET=your-refresh-secret-key-change-me
SIMULATOR_SECRET=simulator-local-secret

# Firebase Admin SDK credentials path
# Default: ./config/firebase-credentials.json
# The system will auto-detect the file. If missing, OTP runs in dev simulation mode.
# FIREBASE_CREDENTIALS_PATH=
# Optional: Firebase Admin SDK credentials path
# Leave empty for dev simulation mode
FIREBASE_CREDENTIALS_PATH=
+
+# Default Users
+DEFAULT_NOC_EMAIL=noc@turkcell.com
+DEFAULT_NOC_PASSWORD=noc
+DEFAULT_SAHA_EMAIL=saha@turkcell.com
+DEFAULT_SAHA_PASSWORD=saha
+DEFAULT_SEBEKE_EMAIL=sebeke@turkcell.com
+DEFAULT_SEBEKE_PASSWORD=sebeke

